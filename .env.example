# Copy to .env.local. This file has no secrets. The repo is public.

# Admin (created by the wizard or `npm run setup:admin`)
# ADMIN_USERNAME=
# ADMIN_PASSWORD_HASH=
# ADMIN_SESSION_SECRET=

# Optional mesh token. Unset: created on first boot in data/mesh.token
# GROWCAST_MESH_TOKEN=

# Optional Twitch EventSub / channel lookup (GrowCast process only)
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# GROWCAST_PUBLIC_URL=

# Daily AI Assessment (server-only). Visitors cannot spend this key.
# Get a key at https://console.x.ai — never commit it.
# Hard cap: 5 xAI HTTP calls per Europe/Berlin day (job + admin regenerate).
XAI_API_KEY=
# Vision-capable Grok model. Default grok-4.3 (image input; cheaper than grok-4.7).
# XAI_MODEL=grok-4.3
# XAI_API_BASE=https://api.x.ai/v1
# Sample assessment on the dashboard, no xAI calls. 1 or true.
# When this and XAI_API_KEY are both unset, the dashboard widget is hidden.
# AI_SUMMARY_DEMO=
